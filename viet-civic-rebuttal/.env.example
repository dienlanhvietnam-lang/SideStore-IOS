# Cổng giao diện web
PORT=4321

# Khóa API tương thích OpenAI (OpenAI, OpenRouter, Azure, v.v.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Mô hình chuyển giọng nói (khi dùng API Whisper)
OPENAI_WHISPER_MODEL=whisper-1

# Bật chế độ demo khi không có khóa API (sinh phản biện mẫu có cấu trúc)
ALLOW_DEMO_MODE=true
